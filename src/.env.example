# Frontend (Vite) environment variables
# Copy this file to .env in the same folder and fill in your values.

# Required for PlayFab client auth in online mode.
VITE_PLAYFAB_TITLE_ID=YOUR_PLAYFAB_TITLE_ID

# Optional: backend URL for online games.
# Defaults in code to http://localhost:3002 when not provided.
VITE_SERVER_URL=http://localhost:3002
